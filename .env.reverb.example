# Append to salonapp/.env
BROADCAST_CONNECTION=reverb

REVERB_APP_ID=salonapp
REVERB_APP_KEY=local-key
REVERB_APP_SECRET=local-secret
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http
# Since the SPA is a separate Vite project (salon-frontend), the matching
# VITE_REVERB_* values go in salon-frontend/.env — see .env.example there.
