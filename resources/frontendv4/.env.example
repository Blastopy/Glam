# Copy to .env in salon-frontend/ — values must match salonapp's REVERB_* settings
VITE_REVERB_APP_KEY=local-key
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http

# Base URL the SPA's axios/auth requests hit — used by echo.js for the /broadcasting/auth call
VITE_API_URL=http://localhost:8000
